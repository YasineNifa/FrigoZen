{
  "compilerOptions": {
    "module": "commonjs",
    "noImplicitReturns": true,
    "noUnusedLocals": true,
    "outDir": "lib",
    "sourceMap": true,
    "strict": true,
    "target": "es2017",

    "esModuleInterop": true, // <--- AJOUTEZ CETTE LIGNE

    "resolveJsonModule": true // <-- (Ajoutez aussi celle-ci, c'est une bonne pratique)
  },
  "compileOnSave": true,
  "include": [
    "src"
  ]
}